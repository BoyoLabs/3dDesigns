module logo_2d() {
    // Build the logo silhouette as a 2D shape by unioning rectangles.
    // We add a +0.5 epsilon to each dimension so adjacent unit-pixel runs
    // merge cleanly without leaving hairline gaps.
    eps = 0.6;
    union() {
        for (r = LOGO_RECTS) {
            translate([r[0] - eps/2, r[1] - eps/2])
                square([r[2] + eps, 1 + eps]);
        }
    }
}

module logo_deboss() {
    // 2D logo extruded to the deboss depth. Scale logo to logo_diameter mm.
    scale_xy = logo_diameter / LOGO_W;
    linear_extrude(height = logo_depth_mm + 0.001, convexity = 10)
        scale([scale_xy, scale_xy])
            logo_2d();
}

// ---------- ASSEMBLY ----------
module kuksa() {
    difference() {
        union() {
            bowl_outer_solid();
            handle_solid();
        }
        bowl_cavity();

        // Logo deboss into the underside of the flat bottom pad.
        // Mirror in X so the logo reads correctly when viewing from below.
        translate([0, 0, -bowl_height - 0.0005])
            mirror([1, 0, 0])
                logo_deboss();

        // Inside-rim chamfer
        translate([0, 0, -rim_chamfer])
            difference() {
                cylinder(h = rim_chamfer + 0.02,
                         d1 = bowl_top_dia,
                         d2 = bowl_top_dia - 2*rim_chamfer);
                translate([0, 0, -0.01])
                    cylinder(h = rim_chamfer + 0.04,
                             d = bowl_top_dia - 2*wall_thickness);
            }

        // Safety: nothing pokes above the flat top plane
        translate([0, 0, 0])
            linear_extrude(height = 80)
                square([500, 500], center = true);
    }
}

